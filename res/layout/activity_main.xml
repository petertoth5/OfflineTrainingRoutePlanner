<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Map View: 70-75% of screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Control Panel: 25-30% of screen, scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/background_panel">

            <!-- GROUP 1: STATUS BAR -->
            <LinearLayout
                android:id="@+id/statusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/focus_border"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Ready"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/background_light"
                    android:contentDescription="Current status of the route planner" />

            </LinearLayout>

            <!-- GROUP 2: QUICK ACTIONS -->
            <LinearLayout
                android:id="@+id/quickActionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearStart"
                    style="@style/Widget.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Clear Start"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Clear the selected start point" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearEnd"
                    style="@style/Widget.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Clear End"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Clear the selected end point" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewRoute"
                    style="@style/Widget.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="New Route"
                    android:textSize="12sp"
                    android:contentDescription="Clear all points and start a new route" />

            </LinearLayout>

            <!-- GROUP 3: START/END POINT DISPLAY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvStartPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start: Not set"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Selected start point coordinates" />

                <TextView
                    android:id="@+id/tvEndPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="End: Not set"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:contentDescription="Selected end point coordinates" />

            </LinearLayout>

            <!-- GROUP 4: PROFILE SELECTOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity Profile"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnProfileRun">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileRun"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Running"
                    android:textSize="12sp"
                    android:contentDescription="Select running profile for route generation" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileBike"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Biking"
                    android:textSize="12sp"
                    android:contentDescription="Select biking profile for route generation" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- GROUP 5: DISTANCE INPUT -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/distanceInputLayout"
                style="@style/Widget.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Distance (km)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDistance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:contentDescription="Enter desired route distance in kilometers" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- GROUP 6: TOLERANCE PARAMETERS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance Tolerance"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <!-- Min Tolerance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shorter:"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text" />

                    <TextView
                        android:id="@+id/tvMinToleranceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-500m"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Minimum route distance tolerance value" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarMinTolerance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2000"
                    android:progress="500"
                    android:layout_marginBottom="12dp"
                    android:progressTint="@color/primary_blue"
                    android:thumbTint="@color/primary_blue"
                    android:contentDescription="Adjust tolerance for shorter routes, range 0 to 2000 meters" />

                <!-- Max Tolerance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Longer:"
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text" />

                    <TextView
                        android:id="@+id/tvMaxToleranceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+500m"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Maximum route distance tolerance value" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarMaxTolerance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2000"
                    android:progress="500"
                    android:progressTint="@color/primary_blue"
                    android:thumbTint="@color/primary_blue"
                    android:contentDescription="Adjust tolerance for longer routes, range 0 to 2000 meters" />

            </LinearLayout>

            <!-- GROUP 7: GENERATE BUTTON (Primary Action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                style="@style/Widget.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Generate Route"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Generate route with selected parameters" />

            <!-- GROUP 8: RESULTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route Information"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRouteInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route info will appear here"
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_marginBottom="12dp"
                android:contentDescription="Generated route information and statistics" />

            <!-- GROUP 9: EXPORT/SETTINGS -->
            <LinearLayout
                android:id="@+id/actionsFooterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/Widget.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Export GPX"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Export generated route as GPX file" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Settings"
                    android:textSize="12sp"
                    android:contentDescription="Open application settings" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
