<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background_light">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Route Planner"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:textColor="@color/primary_text"
        android:contentDescription="Route Planner application title" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:textColor="@color/secondary_text"
        android:contentDescription="Application initialization status" />

    <!-- Region Selector (initially hidden) -->
    <Spinner
        android:id="@+id/spinnerRegion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:contentDescription="Select region for data download" />

    <!-- Download Button (initially hidden) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownload"
        style="@style/Widget.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Download OSM Data"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:contentDescription="Download OpenStreetMap data for the selected region" />

    <!-- Progress Bar (initially hidden) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:progressTint="@color/primary_blue"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

    <!-- Download Progress Status Text (initially hidden) -->
    <TextView
        android:id="@+id/tvDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="@color/secondary_text"
        android:contentDescription="Download progress percentage" />

</LinearLayout>
