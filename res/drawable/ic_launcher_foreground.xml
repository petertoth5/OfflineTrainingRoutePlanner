<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background -->
    <path
        android:fillColor="@color/primary_blue"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"/>

    <!-- Running figure (left side) -->
    <group
        android:scaleX="2.0"
        android:scaleY="2.0"
        android:translateX="8"
        android:translateY="15">
        <!-- Head -->
        <circle
            android:cx="13.49"
            android:cy="3.48"
            android:r="2"
            android:fillColor="@color/background_light"/>
        <!-- Body -->
        <path
            android:fillColor="@color/background_light"
            android:pathData="M13.49,5.5 L13.49,12"/>
        <!-- Left arm (forward) -->
        <path
            android:fillColor="@color/background_light"
            android:strokeColor="@color/background_light"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M13.49,7 L10,9"/>
        <!-- Right arm (back) -->
        <path
            android:fillColor="@color/background_light"
            android:strokeColor="@color/background_light"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M13.49,7 L16,10"/>
        <!-- Left leg (forward) -->
        <path
            android:fillColor="@color/background_light"
            android:strokeColor="@color/background_light"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M13.49,12 L12,16"/>
        <!-- Right leg (back) -->
        <path
            android:fillColor="@color/background_light"
            android:strokeColor="@color/background_light"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M13.49,12 L15,15"/>
    </group>

    <!-- Route path with waypoints (right side) -->
    <!-- Start point (red circle) -->
    <circle
        android:cx="70"
        android:cy="20"
        android:r="3.5"
        android:fillColor="@color/start_point_red"/>

    <!-- Curved route path -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/background_light"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M70,20 Q75,30 70,40 Q65,50 75,60"/>

    <!-- Waypoint 1 (yellow circle) -->
    <circle
        android:cx="70"
        android:cy="40"
        android:r="2.5"
        android:fillColor="@color/midpoint_yellow"/>

    <!-- End point (green pin) -->
    <g
        android:translateX="75"
        android:translateY="60">
        <path
            android:fillColor="@color/end_point_green"
            android:pathData="M0,-6 C-3.3,-6 -6,-3.3 -6,0 C-6,3.5 0,7 0,7 C0,7 6,3.5 6,0 C6,-3.3 3.3,-6 0,-6 Z"/>
        <circle
            android:cx="0"
            android:cy="0"
            android:r="2"
            android:fillColor="@color/background_light"/>
    </g>

</vector>
